{
  "manifest_version": 3,
  "name": "MyMarkdownViewer",
  "version": "5.3",
  "description": "Dark Mode • Themes • Autoreload • Mermaid Diagrams • PlantUML • MathJax • ToC • Syntax Highlighting",
  "homepage_url": "https://github.com/simov/markdown-viewer",
  "icons": {
    "16": "/icons/default/16x16.png",
    "19": "/icons/default/19x19.png",
    "38": "/icons/default/38x38.png",
    "48": "/icons/default/48x48.png",
    "128": "/icons/default/128x128.png"
  },
  "action": {
    "default_icon": {
      "16": "/icons/default/16x16.png",
      "19": "/icons/default/19x19.png",
      "38": "/icons/default/38x38.png",
      "48": "/icons/default/48x48.png",
      "128": "/icons/default/128x128.png"
    },
    "default_title": "MyMarkdownViewer",
    "default_popup": "/popup/index.html"
  },
  "background": {
    "service_worker": "/background/index.js"
  },
  "options_page": "/options/index.html",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "/content/anchor.svg",
        "/icons/default/16x16.png",
        "/icons/dark/16x16.png",
        "/icons/light/16x16.png",
        "/themes/*",
        "/vendor/mathjax/fonts/*",
        "/vendor/prism.min.css",
        "/vendor/prism-okaidia.min.css"
      ]
    }
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "optional_host_permissions": [
    "*://*/"
  ],
  "optional_permissions": [
    "webRequest"
  ],
  "key": ""
}
